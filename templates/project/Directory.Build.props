<Project>

  <!-- Commun à tous les projets de la solution. Un .csproj peut toujours redéfinir une propriété. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Qualité du code : les analyseurs .NET au niveau recommandé, les règles de style de .editorconfig vérifiées
       à la compilation (pas seulement dans l'IDE), et tout avertissement fait échouer la compilation, pour qu'aucun ne s'accumule. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Requis par IDE0005 (using inutile) à la compilation. CS1591 exigerait un commentaire XML sur chaque membre public. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--#if (false) -->
  <!-- Démo seulement : active les modules, pour que le dépôt du modèle les compile et les teste.
       inmemory et database s'excluent : la démo utilise database.
       Le moteur de modèles retire ce bloc des projets générés. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);UseScalar;UseSwaggerUi;UseDatabase;UseEfCore;UseTelemetry</DefineConstants>
  </PropertyGroup>
  <!--#endif -->

</Project>
