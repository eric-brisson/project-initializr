{
  "$schema": "http://json.schemastore.org/template",
  "author": "Starter Maintainers",
  "classifications": ["Web", "API"],
  "identity": "Starter.Api",
  "name": "Project Initializr",
  "shortName": "project-initializr",
  "sourceName": "Starter.Template",
  "preferNameDirectory": false,
  "guids": ["e6a7d71c-b404-43dd-9bfb-5e781c80e435"],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "modules": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "description": "Optional modules to include.",
      "choices": [
        { "choice": "scalar", "description": "Scalar API reference (/scalar)" },
        { "choice": "swaggerui", "description": "Swagger UI (/swagger)" },
        { "choice": "inmemory", "description": "EF Core with an in-memory SQLite database (no Docker)" },
        { "choice": "database", "description": "EF Core with SQL Server in docker compose, Flyway migrations" },
        { "choice": "telemetry", "description": "OpenTelemetry traces, metrics and logs in a local Aspire dashboard (docker compose)" }
      ],
      "defaultValue": "scalar|swaggerui"
    },
    "UseScalar": {
      "type": "computed",
      "value": "(modules == scalar)"
    },
    "UseSwaggerUi": {
      "type": "computed",
      "value": "(modules == swaggerui)"
    },
    "UseDatabase": {
      "type": "computed",
      "value": "(modules == database)"
    },
    "UseInMemory": {
      "type": "computed",
      "description": "inmemory and database exclude each other: database wins when both are given.",
      "value": "(modules == inmemory && !(modules == database))"
    },
    "UseTelemetry": {
      "type": "computed",
      "value": "(modules == telemetry)"
    },
    "UseEfCore": {
      "type": "computed",
      "description": "A data module is selected: the features store their data with EF Core.",
      "value": "(UseDatabase || UseInMemory)"
    },
    "IsFeature": {
      "type": "computed",
      "description": "False here, true in the feature template: both share the Technologies files, whose TODO comments only go to generated features.",
      "value": "false"
    },
    "launchUrl": {
      "type": "generated",
      "generator": "switch",
      "description": "Page opened by the debugger (launchSettings.json): Scalar when selected, otherwise Swagger UI, otherwise the about endpoint. The template keeps scalar, so the repo opens Scalar.",
      "replaces": "scalar",
      "onlyIf": [{ "after": "\"launchUrl\": \"" }],
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseScalar)", "value": "scalar" },
          { "condition": "(UseSwaggerUi)", "value": "swagger" },
          { "condition": "(true)", "value": "api/v1/about" }
        ]
      }
    },
    "databaseName": {
      "type": "parameter",
      "datatype": "string",
      "description": "SQL Server database name (database module). Defaults to the solution name without dots (Sample.Orders → SampleOrders).",
      "defaultValue": ""
    },
    "sqlPort": {
      "type": "parameter",
      "datatype": "string",
      "description": "Host port of SQL Server (database module), shown in the README and in appsettings.Development.json. starter-init passes another one when 1433 is taken.",
      "defaultValue": "1433",
      "replaces": "1433",
      "onlyIf": [{ "after": "localhost," }]
    },
    "defaultDatabaseName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [{ "regex": "[^A-Za-z0-9_]+", "replacement": "" }]
      }
    },
    "databaseNameOrDefault": {
      "type": "generated",
      "generator": "coalesce",
      "replaces": "StarterTemplate",
      "parameters": {
        "sourceVariableName": "databaseName",
        "fallbackVariableName": "defaultDatabaseName"
      }
    },
    "composeNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "name", "toLower": true }
    },
    "composeName": {
      "type": "generated",
      "generator": "regex",
      "description": "docker compose project name: the solution name in lowercase, dots and other characters as dashes (Sample.Orders → sample-orders).",
      "replaces": "starter-template",
      "parameters": {
        "source": "composeNameLower",
        "steps": [
          { "regex": "[^a-z0-9_-]+", "replacement": "-" },
          { "regex": "^[-_]+", "replacement": "" }
        ]
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".github/**",
            ".vs/**",
            ".template.config/**",
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            "**/TestResults/**",
            "**/*.user"
          ]
        },
        {
          "condition": "(!UseDatabase)",
          "exclude": [
            "db/**",
            "tests/Starter.Template.Api.IntegrationTests/SqlServerDatabase.cs"
          ]
        },
        {
          "condition": "(!UseTelemetry)",
          "exclude": [
            "src/Starter.Template.Api/Common/Telemetry/**",
            "tests/Starter.Template.Api.IntegrationTests/TelemetryTests.cs",
            "tests/Starter.Template.Api.UnitTests/Common/Telemetry/**",
            "src/Starter.Template.Api/Properties/launchSettings.json"
          ],
          "rename": {
            "src/Starter.Template.Api/Properties/launchSettings.notelemetry.json": "src/Starter.Template.Api/Properties/launchSettings.json"
          }
        },
        {
          "condition": "(UseTelemetry)",
          "exclude": ["src/Starter.Template.Api/Properties/launchSettings.notelemetry.json"]
        },
        {
          "condition": "(!UseInMemory)",
          "exclude": ["src/Starter.Template.Api/Common/Data/InMemoryDatabase.cs"]
        },
        {
          "condition": "(!UseEfCore)",
          "exclude": ["src/Starter.Template.Api/Common/Data/**"]
        },
        {
          "condition": "(UseEfCore)",
          "exclude": [
            "src/Starter.Template.Api/Features/Technologies/TechnologyStore.cs",
            "tests/Starter.Template.Api.UnitTests/Features/Technologies/**"
          ]
        }
      ]
    }
  ]
}
