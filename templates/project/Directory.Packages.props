<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--#if (UseDatabase) -->
    <!-- Permet aux versions « Security » ci-dessous de remplacer celles demandées par les dépendances. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--#endif -->
  </PropertyGroup>
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!--#if (UseScalar) -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
    <!--#endif -->
    <!--#if (UseSwaggerUi) -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <!--#endif -->
    <!--#if (UseInMemory) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!--#endif -->
    <!--#if (UseDatabase) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!--#endif -->
    <!--#if (UseEfCore) -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <!--#endif -->
  </ItemGroup>
  <!--#if (UseTelemetry) -->
  <ItemGroup Label="Telemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!--#if (UseDatabase) -->
    <!-- Stable, contrairement à l'instrumentation EF Core (encore en bêta), et elle voit aussi les requêtes d'EF Core. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
    <!--#endif -->
  </ItemGroup>
  <!--#endif -->
  <!--#if (UseDatabase) -->
  <ItemGroup Label="Security">
    <!-- Microsoft.Data.SqlClient 6.1 dépend de la 9.0.11, qui a des vulnérabilités connues (corrigées en 10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <!--#endif -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <!--#if (UseDatabase) -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!--#endif -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>