{
  "$schema": "http://json.schemastore.org/template",
  "author": "Starter Maintainers",
  "classifications": ["Web", "API", "Feature"],
  "identity": "Starter.Feature",
  "name": "Project Initializr feature",
  "shortName": "starter-feature",
  "description": "A CRUD feature (vertical slices and tests) for a project-initializr solution, made from its Technologies feature. Run it from the solution folder.",
  "sourceName": "Technology",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "plural": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "Plural of the name, used for the folder, the route and the table (Account → Accounts).",
      "replaces": "Technologies",
      "fileRename": "Technologies"
    },
    "solution": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "Solution name, as in src/<solution>.Api (e.g. Sample.Orders).",
      "replaces": "Starter.Template",
      "fileRename": "Starter.Template"
    },
    "data": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": true,
      "description": "The data module of the solution, as in its .starter.json.",
      "choices": [
        { "choice": "none", "description": "No data module: a singleton in-memory store" },
        { "choice": "sqlite", "description": "inmemory module: EF Core with SQLite" },
        { "choice": "sqlserver", "description": "database module: EF Core with SQL Server" }
      ]
    },
    "UseDatabase": {
      "type": "computed",
      "value": "(data == sqlserver)"
    },
    "UseInMemory": {
      "type": "computed",
      "value": "(data == sqlite)"
    },
    "UseEfCore": {
      "type": "computed",
      "value": "(UseDatabase || UseInMemory)"
    },
    "IsFeature": {
      "type": "computed",
      "description": "Keeps the TODO comments of the shared files, which the project template removes.",
      "value": "true"
    },
    "routeKebab": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "plural",
        "steps": [{ "regex": "([a-z0-9])([A-Z])", "replacement": "$1-$2" }]
      }
    },
    "route": {
      "type": "generated",
      "generator": "casing",
      "description": "The route segment: the plural in kebab case (UserProfiles → user-profiles).",
      "replaces": "technologies",
      "parameters": { "source": "routeKebab", "toLower": true }
    }
  },
  "sources": [
    {
      "source": "../project/",
      "target": "./",
      "include": [
        "src/Starter.Template.Api/Features/Technologies/**",
        "tests/Starter.Template.Api.IntegrationTests/Features/Technologies/**",
        "tests/Starter.Template.Api.UnitTests/Features/Technologies/**"
      ],
      "modifiers": [
        {
          "condition": "(UseEfCore)",
          "exclude": [
            "src/Starter.Template.Api/Features/Technologies/TechnologyStore.cs",
            "tests/Starter.Template.Api.UnitTests/Features/Technologies/**"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "How to wire the feature.",
      "manualInstructions": [
        {
          "text": "Wire the feature: call Map<Plural>Endpoints() in Common/EndpointRegistration.cs and Add<Plural>Services() in Common/ServiceRegistration.cs. With SQL Server, create its table in a new Flyway script. Then fill in the TODOs."
        }
      ],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    }
  ]
}
