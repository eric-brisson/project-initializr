{
  "$schema": "http://json.schemastore.org/template",
  "author": "Starter Maintainers",
  "classifications": ["Web", "API"],
  "identity": "Starter.Api",
  "name": "Project Initializr",
  "shortName": "project-initializr",
  "sourceName": "Starter.Template",
  "preferNameDirectory": false,
  "guids": ["e6a7d71c-b404-43dd-9bfb-5e781c80e435"],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "modules": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "description": "Optional modules to include.",
      "choices": [
        { "choice": "scalar", "description": "Scalar API reference (/scalar)" },
        { "choice": "swaggerui", "description": "Swagger UI (/swagger)" },
        { "choice": "inmemory", "description": "EF Core with an in-memory SQLite database (no Docker)" },
        { "choice": "database", "description": "EF Core with SQL Server in docker compose, Flyway migrations" }
      ],
      "defaultValue": "scalar|swaggerui"
    },
    "UseScalar": {
      "type": "computed",
      "value": "(modules == scalar)"
    },
    "UseSwaggerUi": {
      "type": "computed",
      "value": "(modules == swaggerui)"
    },
    "UseDatabase": {
      "type": "computed",
      "value": "(modules == database)"
    },
    "UseInMemory": {
      "type": "computed",
      "description": "inmemory and database exclude each other: database wins when both are given.",
      "value": "(modules == inmemory && !(modules == database))"
    },
    "databaseName": {
      "type": "parameter",
      "datatype": "string",
      "description": "SQL Server database name (database module). Defaults to the solution name without dots (Sample.Orders → SampleOrders).",
      "defaultValue": ""
    },
    "defaultDatabaseName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [{ "regex": "[^A-Za-z0-9_]+", "replacement": "" }]
      }
    },
    "databaseNameOrDefault": {
      "type": "generated",
      "generator": "coalesce",
      "replaces": "StarterTemplate",
      "parameters": {
        "sourceVariableName": "databaseName",
        "fallbackVariableName": "defaultDatabaseName"
      }
    },
    "composeNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "name", "toLower": true }
    },
    "composeName": {
      "type": "generated",
      "generator": "regex",
      "description": "docker compose project name: the solution name in lowercase, dots and other characters as dashes (Sample.Orders → sample-orders).",
      "replaces": "starter-template",
      "parameters": {
        "source": "composeNameLower",
        "steps": [
          { "regex": "[^a-z0-9_-]+", "replacement": "-" },
          { "regex": "^[-_]+", "replacement": "" }
        ]
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".github/**",
            ".vs/**",
            ".template.config/**",
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            "**/TestResults/**",
            "**/*.user"
          ]
        },
        {
          "condition": "(!UseDatabase)",
          "exclude": [
            "compose.yaml",
            "db/**",
            "tests/Starter.Template.Api.IntegrationTests/SqlServerDatabase.cs"
          ]
        },
        {
          "condition": "(!UseInMemory)",
          "exclude": ["src/Starter.Template.Api/Common/Data/InMemoryDatabase.cs"]
        },
        {
          "condition": "(!UseDatabase && !UseInMemory)",
          "exclude": [
            "src/Starter.Template.Api/Common/Data/**",
            "src/Starter.Template.Api/Features/Technologies/Technology.cs",
            "src/Starter.Template.Api/Features/Technologies/TechnologyConfiguration.cs"
          ]
        },
        {
          "condition": "(UseDatabase || UseInMemory)",
          "exclude": ["tests/Starter.Template.Api.UnitTests/Features/Technologies/TechnologyCatalogTests.cs"]
        }
      ]
    }
  ]
}
