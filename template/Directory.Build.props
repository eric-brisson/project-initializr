<Project>

  <!--#if (false) -->
  <!-- Demo only: turn the modules on, so the template repo builds and tests them.
       inmemory and database exclude each other: the demo uses database.
       The template engine removes this block from generated projects. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);UseScalar;UseSwaggerUi;UseDatabase</DefineConstants>
  </PropertyGroup>
  <!--#endif -->

</Project>
