<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--#if (UseDatabase) -->
    <!-- Lets the "Security" versions below override the ones dependencies ask for. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--#endif -->
  </PropertyGroup>
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!--#if (UseScalar) -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
    <!--#endif -->
    <!--#if (UseSwaggerUi) -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <!--#endif -->
    <!--#if (UseInMemory) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!--#endif -->
    <!--#if (UseDatabase) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!--#endif -->
  </ItemGroup>
  <!--#if (UseDatabase) -->
  <ItemGroup Label="Security">
    <!-- Microsoft.Data.SqlClient 6.1 depends on 9.0.11, which has known vulnerabilities (fixed in 10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <!--#endif -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <!--#if (UseDatabase) -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!--#endif -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>